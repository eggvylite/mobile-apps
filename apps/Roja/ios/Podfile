# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'DemoROJA' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  permissions_path = '../node_modules/react-native-permissions/ios'

  pod 'RNVectorIcons', :path => '../node_modules/react-native-vector-icons'
  pod 'RNFBMessaging', :path => '../node_modules/@react-native-firebase/messaging'
  pod 'Firebase'
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # ============================================================
    # fmt / Xcode 26 workaround (Robust Source Patch)
    # ============================================================
    fmt_base_h = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')

    if File.exist?(fmt_base_h)
      File.chmod(0644, fmt_base_h)
      content = File.read(fmt_base_h)

      # Use gsub with regex to handle any whitespace variations
      if content =~ /#\s*define\s+FMT_USE_CONSTEVAL\s+1/
        content = content.gsub(/#\s*define\s+FMT_USE_CONSTEVAL\s+1/, '#define FMT_USE_CONSTEVAL 0')
        File.write(fmt_base_h, content)
        puts "✅ fmt workaround: FMT_USE_CONSTEVAL disabled in base.h"
      elsif content =~ /#\s*define\s+FMT_USE_CONSTEVAL\s+0/
        puts "ℹ️ fmt workaround: FMT_USE_CONSTEVAL already disabled"
      else
        # Fallback: inject at top if pattern not found
        unless content.include?('FMT_USE_CONSTEVAL')
          content = "#define FMT_USE_CONSTEVAL 0\n#{content}"
          File.write(fmt_base_h, content)
          puts "✅ fmt workaround: Injected FMT_USE_CONSTEVAL 0 at top of base.h"
        end
      end
    else
      puts "⚠️ WARNING: fmt base.h not found at #{fmt_base_h}"
    end

    # ============================================================
    # Pod build settings
    # ============================================================
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|

        # ALL targets use C++20
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        
        # FIX: Use array concatenation instead of hard overwrite
        existing_cpp_flags = build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
        existing_cpp_flags = [existing_cpp_flags] if existing_cpp_flags.is_a?(String)
        existing_cpp_flags |= ['-std=c++20', '-fno-aligned-new']
        build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] = existing_cpp_flags

        # Define REACT_NATIVE_MINOR_VERSION for RNReanimated
        if target.name == 'RNReanimated'
          existing_flags = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          existing_flags = [existing_flags] if existing_flags.is_a?(String)
          existing_flags << 'REACT_NATIVE_MINOR_VERSION=81' unless existing_flags.include?('REACT_NATIVE_MINOR_VERSION=81')
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = existing_flags
        end

        # Backup: Also add FMT_USE_CONSTEVAL=0 to all targets via preprocessor definitions
        gcc_defs = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
        gcc_defs = [gcc_defs] if gcc_defs.is_a?(String)
        gcc_defs << 'FMT_USE_CONSTEVAL=0' unless gcc_defs.any? { |d| d.include?('FMT_USE_CONSTEVAL=0') }
        build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = gcc_defs

        # Pods do not need code signing
        build_config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'

        # iOS deployment target
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'

        # Warnings
        build_config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        build_config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      end
    end
  end
end
